# =========================================================
#  Kindergarten Farbklecks – Server-Konfiguration (Apache)
#  Diese Datei nur verwenden, wenn der Server Apache nutzt.
#  Bei nginx werden die Regeln in der Server-Konfiguration
#  hinterlegt – bitte den Hoster fragen.
# =========================================================

# ---- 1. Fehlerseite ----
ErrorDocument 404 /404.html

# ---- 2. HTTPS erzwingen ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ---- 3. Weiterleitungen der alten WordPress-Adressen ----
  # WICHTIG: Vor dem Umzug die alten URLs prüfen und diese Liste ergänzen.
  # Beispiele (bitte anpassen):
  # RewriteRule ^ueber-uns/?$            /unser-haus.html   [R=301,L]
  # RewriteRule ^konzept/?$              /paedagogik.html   [R=301,L]
  # RewriteRule ^oeffnungszeiten/?$      /betreuung.html    [R=301,L]
  # RewriteRule ^anmeldung/?$            /anmeldung.html    [R=301,L]
  # RewriteRule ^aktuelles/?$            /aktuelles.html    [R=301,L]
  # RewriteRule ^kontakt/?$              /kontakt.html      [R=301,L]
  # RewriteRule ^impressum/?$            /impressum.html    [R=301,L]
  # RewriteRule ^datenschutz/?$          /datenschutz.html  [R=301,L]
  #
  # Alte PDF-Dateien aus dem WordPress-Upload-Ordner:
  # RewriteRule ^wp-content/uploads/Kindergarten-Farbklecks-Anmeldeformular\.pdf$ /assets/downloads/anmeldeformular.pdf [R=301,L]
</IfModule>

# ---- 4. Komprimierung ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript image/svg+xml
</IfModule>

# ---- 5. Browser-Zwischenspeicher ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 6 months"
  ExpiresByType image/png           "access plus 6 months"
  ExpiresByType image/webp          "access plus 6 months"
  ExpiresByType image/svg+xml       "access plus 6 months"
  ExpiresByType text/html           "access plus 1 hour"
</IfModule>

# ---- 6. Sicherheits-Header ----
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- 7. Verzeichnis-Auflistung verbieten ----
Options -Indexes
